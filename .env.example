# Copy to .env.local and fill in. .env.local is gitignored.

# Google Gemini (Nur AI companion)
GEMINI_API_KEY=

# Supabase — Community & auth. Project Settings -> API.
# The anon (public) key is safe in the client; NEVER put the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Push notifications (circle chat + DMs). Only set to "true" once
# android/app/google-services.json is actually in place — see
# services/pushNotifications.ts for why this is a hard requirement, not optional.
FCM_ENABLED=

# --- Local Supabase CLI only (supabase/config.toml env() substitution) ---
# Google OAuth provider credentials for `supabase start`. In the hosted project
# these are configured in the dashboard (Authentication -> Providers -> Google).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
